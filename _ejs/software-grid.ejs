```{=html}

<style>
  .software-image-box {
    height: 280px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .software-image-box img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .software-title {
    font-size: 1.25rem !important;
    font-weight: 700 !important;
    line-height: 1.2;
    margin-bottom: 0.35rem;
  }
</style>

<div class="quarto-listing quarto-listing-container-grid">

  <div class="list grid quarto-listing-cols-2">

    <% for (const item of items) { %>

    <div class="g-col-1">
      <div class="quarto-grid-item card h-100">

        <a href="<%- item.path %>"
           class="quarto-grid-link"
           aria-label="<%= item.title.replace(/<[^>]*>/g, '') %>">

          <div class="software-image-box">
            <img loading="lazy"
                 src="<%= item.image %>"
                 alt="<%= item['image-alt'] || item.title.replace(/<[^>]*>/g, '') %>">
          </div>

        </a>

        <div class="card-body post-contents">

          <a href="<%- item.path %>"
             aria-label="<%= item.title.replace(/<[^>]*>/g, '') %>">

            <h5 class="no-anchor card-title listing-title software-title">
              <%- item.title %>
            </h5>

          </a>

          <div class="card-text listing-description">
            <%= item.description %>
          </div>

        </div>

      </div>
    </div>

    <% } %>

  </div>

</div>
```
